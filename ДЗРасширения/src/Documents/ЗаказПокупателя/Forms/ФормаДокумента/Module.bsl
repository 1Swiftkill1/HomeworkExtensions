#Область ОбработчикиСобытийЭлементовШапкиФормы
// ++Голубев Д.С. Задача 2353 29.08.2026 20:22:47

&НаКлиенте
Процедура ДФ_СогласованнаяСкидкаПриИзменении(Элемент) 
	
	// ++Голубев Д.С. Задача 2353 29.08.2026 20:22:47
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДФ_ПересчитатьСуммуСтрокПриИзмененииАсинх(Объект.Товары, Объект.Услуги, Объект.ДФ_СогласованнаяСкидка);
	// --Голубев Д.С. Задача 2353 29.08.2026 20:22:47
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДФ_ПересчитатьСуммуСтрокПриИзмененииАсинх(ТабличнаяЧастьТовары, ТабличнаяЧастьУслуги, СкидкаПроцент) Экспорт
	
	// ++Голубев Д.С. Задача 2353 31.08.2026 23:56:43
	Ответ = Ждать ВопросАсинх("Пересчитать суммы всех строк с учетом новой скидки?", РежимДиалогаВопрос.ДаНет);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДФ_РаботаСоСкидками.ДФ_ПересчитатьВсеСтроки(ТабличнаяЧастьТовары, ТабличнаяЧастьУслуги, СкидкаПроцент);
		РассчитатьСуммуДокумента();
	КонецЕсли;
	// --Голубев Д.С. Задача 2353 31.08.2026 23:56:43
	
КонецПроцедуры 

// --Голубев Д.С. Задача 2353 29.08.2026 20:22:47
#КонецОбласти

#Область ОбработчикиКомандФормы
// ++Голубев Д.С. Задача 2353 29.08.2026 20:41:18

&НаКлиенте
Процедура ДФ_ПересчитатьТаблицу(Команда)
	
	// ++Голубев Д.С. Задача 2353 29.08.2026 20:41:18
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДФ_РаботаСоСкидками.ДФ_ПересчитатьВсеСтроки(Объект.Товары, Объект.Услуги, Объект.ДФ_СогласованнаяСкидка);
	
	РассчитатьСуммуДокумента();
	// --Голубев Д.С. Задача 2353 29.08.2026 20:41:18
	
КонецПроцедуры

// --Голубев Д.С. Задача 2353 29.08.2026 20:41:18
#КонецОбласти
